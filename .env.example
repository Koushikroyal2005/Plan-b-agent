# Plan B server-side configuration placeholders
APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/planb

# Reasoning provider adapter
LLM_PROVIDER=nvidia-nim
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-on-server-only

# Optional voice adapters
ASR_PROVIDER=browser
ASR_MODEL=replace-with-model-id
ASR_API_KEY=replace-on-server-only
TTS_PROVIDER=none
TTS_MODEL=replace-with-model-id
TTS_API_KEY=replace-on-server-only

# MCP Streamable HTTP server
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_AUTH_SECRET=replace-with-a-server-secret
